# ============================================================
# wp-trang-chinh-sach-gioi-thieu  —  copy thành ".env" rồi điền
# KHÔNG gửi file này qua chat công khai, KHÔNG commit lên git.
# ============================================================

# ---------- 1. WORDPRESS (bắt buộc) ----------
# Địa chỉ site, có https://, không có dấu / cuối
WP_URL=https://tenmiencuakhach.vn
# Tên đăng nhập của tài khoản QUẢN TRỊ (Administrator)
WP_USER=admin
# Mật khẩu ứng dụng: WP Admin → Người dùng → Hồ sơ → cuộn xuống "Mật khẩu ứng dụng"
# → nhập tên "claude" → Thêm → copy chuỗi 24 ký tự (có dấu cách cũng được).
# KHÔNG phải mật khẩu đăng nhập thường.
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx
# Đặt 0 nếu site dùng chứng chỉ SSL tự ký / local
WP_VERIFY_SSL=1

# ---------- 2. VPS / HOSTING qua SSH (tùy chọn, nên có) ----------
# Dùng để: gán "Trang chính sách bảo mật" trong Cài đặt → Riêng tư,
# gán trang Điều khoản cho WooCommerce, xóa cache, kiểm tra phiên bản.
# Để trống cả khối này nếu hosting không có SSH → skill sẽ in hướng dẫn làm tay.
SSH_HOST=
SSH_PORT=22
SSH_USER=
# Đường dẫn file khóa riêng (khuyên dùng khóa, không dùng mật khẩu)
SSH_KEY=~/.ssh/id_ed25519
# Thư mục gốc WordPress trên máy chủ (nơi có wp-config.php), vd /var/www/html
WP_PATH=
# Lệnh WP-CLI trên máy chủ (đổi nếu cài ở chỗ khác, vd /usr/local/bin/wp)
WP_CLI=wp
# Nếu site nằm ngay trên máy này (local), để SSH_HOST trống và chỉ điền WP_PATH.

# ---------- 3. MENU ----------
MENU_NAME=Chính sách
# Vị trí menu trong Flatsome (thường là "footer"); xem bằng lệnh check
FOOTER_MENU_LOCATION=footer

# ============================================================
# THÔNG TIN DOANH NGHIỆP (Claude sẽ hỏi và điền giúp)
# Thiếu biến nào, trang sẽ có chữ vàng "[CẦN ĐIỀN: ...]" và không cho đăng.
# ============================================================
BIZ_TEN_THUONG_HIEU=
BIZ_TEN_PHAP_NHAN=
BIZ_MST=
BIZ_NGUOI_DAI_DIEN=
BIZ_DIA_CHI=
BIZ_HOTLINE=
BIZ_EMAIL=
BIZ_ZALO=
BIZ_GIO_LAM_VIEC=8:00 – 21:00 hằng ngày
# Mô tả ngắn bán gì (vd: điện máy gia dụng, mỹ phẩm chính hãng)
BIZ_LINH_VUC=
BIZ_SU_MENH=
BIZ_CAU_CHUYEN=
BIZ_GIA_TRI=Uy tín; Chất lượng; Tận tâm
# Chính sách bán hàng
BIZ_THOI_GIAN_DOI_TRA=7
BIZ_THOI_GIAN_BAO_HANH=12 tháng
BIZ_THOI_GIAN_GIAO=2–5 ngày làm việc
BIZ_PHI_SHIP=Tính theo khu vực, hiển thị tại bước thanh toán
BIZ_FREESHIP_TU=500.000đ
BIZ_DON_VI_VAN_CHUYEN=Giao Hàng Nhanh, Viettel Post, J&T Express
BIZ_THANH_TOAN=Thanh toán khi nhận hàng (COD); Chuyển khoản ngân hàng
BIZ_TAI_KHOAN_NH=
# Shortcode form liên hệ nếu có Contact Form 7, vd [contact-form-7 id="123"]
BIZ_CF7_SHORTCODE=
# Mã nhúng Google Maps (iframe) nếu có
BIZ_MAP_EMBED=
